rules_version = '2';

// Todo mundo que usa o Society vê e edita os mesmos futs, guardados em
// grupos/<código do app>/futs. O app não cria grupos: o espaço já existe.
// Ninguém lista os grupos nem apaga um grupo.
service cloud.firestore {
  match /databases/{database}/documents {

    function grupoExiste(codigo) {
      return exists(/databases/$(database)/documents/grupos/$(codigo));
    }

    match /grupos/{codigo} {
      allow get: if true;
      allow list, create, update, delete: if false;

      match /futs/{futId} {
        allow read: if grupoExiste(codigo);
        allow create, update: if grupoExiste(codigo)
          && futId.size() <= 64
          && request.resource.data.keys().hasOnly(['versao', 'dados', 'atualizadoEm'])
          && request.resource.data.versao is int
          && request.resource.data.dados is map;
        allow delete: if grupoExiste(codigo);
      }
    }
  }
}
